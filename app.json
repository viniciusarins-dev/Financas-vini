{
  "expo": {
    "name": "Fluxo",
    "slug": "fluxo-financas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fluxo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fluxo.financas",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSFaceIDUsageDescription": "Use o Face ID para proteger o acesso aos seus dados financeiros."
      }
    },
    "android": {
      "package": "com.fluxo.financas",
      "adaptiveIcon": {
        "backgroundColor": "#05050A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05050A",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "082acb28-47cc-4251-933c-5665116bc504"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/082acb28-47cc-4251-933c-5665116bc504"
    }
  }
}
